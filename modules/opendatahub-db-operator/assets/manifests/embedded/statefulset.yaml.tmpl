apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{.ServiceName}}
  namespace: {{.AppNamespace}}
  labels:
    app.kubernetes.io/name: {{.ServiceName}}
    app.kubernetes.io/component: databaseprovider
    db.infrastructure.opendatahub.io/provider: {{.Component.Name}}
spec:
  replicas: 1
  serviceName: {{.ServiceName}}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{.ServiceName}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{.ServiceName}}
        db.infrastructure.opendatahub.io/provider: {{.Component.Name}}
{{- if .InstanceHash}}
      annotations:
        db.infrastructure.opendatahub.io/admin-secret-key: {{.InstanceHash}}
{{- if and .TLSEnabled .TLSSecretHash}}
        db.infrastructure.opendatahub.io/tls-secret-hash: {{.TLSSecretHash}}
{{- end}}
{{- end}}
    spec:
{{- if .TLSEnabled}}
      securityContext:
        fsGroup: 999
{{- end}}
      containers:
        - name: postgres
          image: {{.ResolvedImage}}
          imagePullPolicy: IfNotPresent
{{- if .TLSEnabled}}
          args:
            - -c
            - ssl=on
            - -c
            - ssl_cert_file=/var/lib/postgresql/tls/tls.crt
            - -c
            - ssl_key_file=/var/lib/postgresql/tls/tls.key
{{- end}}
          ports:
            - name: postgres
              containerPort: 5432
              protocol: TCP
          env:
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: {{.AdminSecretName}}
                  key: pg.user
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{.AdminSecretName}}
                  key: pg.password
            - name: POSTGRES_DB
              valueFrom:
                secretKeyRef:
                  name: {{.AdminSecretName}}
                  key: pg.database
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
            initialDelaySeconds: 5
            timeoutSeconds: 5
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"
            initialDelaySeconds: 15
            timeoutSeconds: 5
{{- with .Component.Spec.Embedded.Resources }}
          resources:{{ toYaml . | nindent 12 }}
{{- end }}
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
            - name: initdb
              mountPath: /docker-entrypoint-initdb.d
{{- if .TLSEnabled}}
            - name: tls
              mountPath: /var/lib/postgresql/tls
              readOnly: true
{{- end}}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{.PVCName}}
        - name: initdb
          configMap:
            name: {{.InitDBConfigMapName}}
{{- if .TLSEnabled}}
        - name: tls
          secret:
            secretName: {{.TLSSecretName}}
            defaultMode: 416
{{- end}}
